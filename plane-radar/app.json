{
  "configVersion": "v3",
  "app": {
    "appId": 1984311,
    "appName": "Plane Radar",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "Dominique Burri",
    "description": "Radar scope of aircraft around you, from free public ADS-B feeds"
  },
  "permissions": ["device:os.geolocation", "device:os.local_storage", "data:os.device.info"],
  "runtime": {
    "apiVersion": { "compatible": "3.0.0", "target": "3.0.0", "minVersion": "3.0" }
  },
  "targets": {
    "default": {
      "module": {
        "page": { "pages": ["page/index"] },
        "app-side": { "path": "app-side/index" }
      },
      "platforms": [{ "st": "s", "dw": 390 }],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": { "appName": "Plane Radar" }
  },
  "defaultLanguage": "en-US"
}
